{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StockerDynamoDB",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/stocker_*",
        "arn:aws:dynamodb:*:*:table/stocker_*/index/*"
      ]
    },
    {
      "Sid": "StockerSNS",
      "Effect": "Allow",
      "Action": ["sns:Publish"],
      "Resource": [
        "arn:aws:sns:*:*:stocker-user-events",
        "arn:aws:sns:*:*:stocker-txn-events"
      ]
    }
  ]
}
