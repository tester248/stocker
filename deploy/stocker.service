[Unit]
Description=Stocker Flask app (gunicorn)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/stocker
EnvironmentFile=/home/ec2-user/stocker/.env
ExecStart=/home/ec2-user/stocker/venv/bin/gunicorn -c gunicorn.conf.py app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
